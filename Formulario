import streamlit as st

st.title("Formulario de Registro")

with st.form(key="registro_form"):
    nombre_mascota = st.text_input("Nombre de la mascota")
    nombre_dueno = st.text_input("Nombre del dueño")
    numero_telefonico = st.text_input("Número de teléfono",
                                      min_value=0,
                                      max_value=120,
                                      value=25)
    submit_button = st.form_submit_button(label="Enviar")

if submit_button:
    st.write(f"Mi nombre es {nombre_mascota} y mi dueño es {nombre_dueno} con número de teléfono {numero_telefonico}")
